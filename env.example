# Runtime
NODE_ENV=production

# PostgreSQL
POSTGRES_DB=niteowl_auth
POSTGRES_USER=niteowl
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Redis
REDIS_PASSWORD=replace-with-a-long-random-password

# Better Auth API
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3031
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3030
AUTH_PORT=3031

# BTST admin
ADMIN_URL=http://localhost:3030
ADMIN_PORT=3030
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3031
