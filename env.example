# Runtime
NODE_ENV=production

# PostgreSQL
POSTGRES_DB=niteowl_auth
POSTGRES_USER=niteowl
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Redis
REDIS_PASSWORD=replace-with-a-long-random-password

# Better Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_PORT=3031

# BTST admin and public application URL
ADMIN_URL=http://localhost:3030
ADMIN_PORT=3030
