    "@react-router/serve": "latest",
    "@tanstack/react-query": "latest",
    "better-auth": "latest",
    "drizzle-orm": "latest",
    "isbot": "latest",
    "pg": "latest",
    "postgres": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router": "latest",
    "sonner": "latest"
  },
  "devDependencies": {
    "@btst/cli": "latest",
    "@react-router/dev": "latest",
    "@tailwindcss/vite": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "drizzle-kit": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
